# Public runtime (embedded at build time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# RAG chatbot — persistent Python server (run: cd lipu-platform/rag && python server.py)
RAG_SERVER_URL=http://127.0.0.1:8100
# RAG_ROOT=F:/Lipu_copilot/lipu-platform/rag

# AI feature flags (Next.js /api/chat)
# Local default: AI_ENABLED=true, AI_MODE=retrieval (when unset in development)
# Production default: AI_ENABLED=false (when unset on Vercel)
AI_ENABLED=true
AI_MODE=retrieval

# Production example:
# NEXT_PUBLIC_API_BASE_URL=https://api.lipu.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://www.lipu.com
# AI_ENABLED=true
# AI_MODE=retrieval
# RAG_SERVER_URL=https://your-railway-rag-service.up.railway.app

# Clerk. Leave blank to keep the marketing site available without accounts.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is safe for the browser.
# CLERK_SECRET_KEY is server-only and must not use the NEXT_PUBLIC_ prefix.
# Production uses a different pk_live_ publishable key and a different CLERK_SECRET_KEY.
# Development localhost keeps the pk_test_ key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/profile
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/profile
