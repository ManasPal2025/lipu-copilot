APP_NAME=LIPU API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Use port 5433 when Postgres runs via docker-compose (host mapping)
DATABASE_URL=postgresql+asyncpg://lipu_user:lipu_password_dev@localhost:5433/lipu_dev
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false
# Set true only for a production database that requires TLS.
DATABASE_SSL=false

# Use port 6380 when Redis runs via docker-compose (host mapping)
REDIS_URL=redis://localhost:6380/0
REDIS_CACHE_TTL=3600
REDIS_DECODE_RESPONSES=true
REDIS_HEALTH_CHECK_INTERVAL=30

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
ALLOWED_HOSTS=localhost,127.0.0.1

LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
SENTRY_DSN=

# Email. Leave EMAIL_ENABLED=false until provider credentials are configured.
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=notifications@example.com
EMAIL_FROM_NAME=Ecotech
ECOTECH_NOTIFICATION_EMAIL=studio@example.com
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true

# Clerk session verification. Leave the secret blank until dashboard keys exist.
# The secret stays on the API. Do not expose it to the browser.
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Private S3-compatible object storage for customer uploads.
# Leave STORAGE_ENABLED=false until a bucket is configured.
# Production can use AWS S3, Cloudflare R2, or another S3-compatible endpoint.
# STORAGE_ACCESS_KEY and STORAGE_SECRET_KEY must be different values in production.
# Identical MinIO root credentials are local development only.
# Leave STORAGE_ENDPOINT empty for AWS, or set the provider endpoint for R2 or another S3 API.
# Leave STORAGE_PUBLIC_BASE_URL empty so objects stay private.
# Do not put real credentials in this file.
STORAGE_ENABLED=false
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_SIGNED_URL_TTL_SECONDS=900
TRANSFORM_MAX_UPLOAD_MB=10

# Server-side image generation. Leave IMAGE_GENERATION_ENABLED=false until a key is configured.
# The key stays on the API. Do not copy it into frontend or NEXT_PUBLIC variables.
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=auto
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_SECONDS=120

# Production uses a separate host environment. Do not copy development secrets into it.
# Required production names, with no values stored here:
# APP_ENV=production
# DEBUG=false
# DATABASE_URL
# DATABASE_SSL=true
# DATABASE_POOL_SIZE
# CORS_ORIGINS=https://<ecotech-domain>
# ALLOWED_HOSTS=<api-host>
# CLERK_SECRET_KEY from the production Clerk instance, not the development instance
# CLERK_AUTHORIZED_PARTIES=https://<ecotech-domain>
# STORAGE_ENABLED=true
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET
# STORAGE_REGION
# STORAGE_ENDPOINT
# STORAGE_ACCESS_KEY
# STORAGE_SECRET_KEY
# STORAGE_SIGNED_URL_TTL_SECONDS
# IMAGE_GENERATION_ENABLED=true
# OPENAI_API_KEY
# EMAIL_SMTP_HOST
# EMAIL_SMTP_USERNAME
# EMAIL_SMTP_PASSWORD
# REDIS_URL only if a later queue or distributed limit is introduced

